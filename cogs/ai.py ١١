import os
import discord
from discord.ext import commands
from google import genai
from google.genai import types

class GeminiAI(commands.Cog):
    def __init__(self, bot):
        self.bot = bot
        api_key = os.getenv("GEMINI_API_KEY")
        if not api_key:
            print("⚠️ [GeminiAI] لم يتم العثور على GEMINI_API_KEY في ملف .env")
            self.client = None
        else:
            self.client = genai.Client(api_key=api_key)
        
        self.user_chats = {}

    async def get_user_chat(self, user_id: int):
        if not self.client:
            return None
        if user_id not in self.user_chats:
            config = types.GenerateContentConfig(
                system_instruction=(
                    "أنت جيميناي (Gemini)، مساعد ذكي مدمج داخل سيرفر ديسكورد. "
                    "أجب بطريقة طبيعية ومباشرة وودودة باللغة العربية، وساعد الأعضاء بذكاء واحترافية."
                ),
                temperature=0.7,
            )
            # إنشاء محادثة تدعم الـ Async عبر client.aio
            self.user_chats[user_id] = self.client.aio.chats.create(
                model="gemini-3.8-flash",
                config=config
            )
        return self.user_chats[user_id]

    async def generate_response(self, user_id: int, prompt: str) -> str:
        if not self.client:
            return "❌ خدمة الذكاء الاصطناعي غير مفعلة؛ يرجى التأكد من وضع `GEMINI_API_KEY` في ملف `.env`."
        
        try:
            chat = await self.get_user_chat(user_id)
            response = await chat.send_message(prompt)
            return response.text or "عذراً، لم أستطع استخراج إجابة."
        except Exception as e:
            # إعادة تهيئة المحادثة في حال حدوث انقطاع أو انتهاء الجلسة
            self.user_chats.pop(user_id, None)
            try:
                chat = await self.get_user_chat(user_id)
                response = await chat.send_message(prompt)
                return response.text or "عذراً، لم أستطع استخراج إجابة."
            except Exception as ex:
                return f"⚠️ خطأ أثناء توليد الرد: {ex}"

    async def send_split_message(self, target, text: str):
        chunks = [text[i:i + 1900] for i in range(0, len(text), 1900)]
        for chunk in chunks:
            if hasattr(target, "send"):
                await target.send(chunk)
            elif hasattr(target, "followup"):
                await target.followup.send(chunk)

    @commands.hybrid_command(
        name="ask",
        aliases=["اسال", "جيميناي", "gemini"],
        description="تحدث مع الذكاء الاصطناعي جيميناي بشكل طبيعي"
    )
    async def ask(self, ctx: commands.Context, *, prompt: str):
        await ctx.defer()
        reply_text = await self.generate_response(ctx.author.id, prompt)
        await self.send_split_message(ctx, f"💬 **{ctx.author.mention}**:\n{reply_text}")

    @commands.hybrid_command(
        name="reset_chat",
        aliases=["تصفير_المحادثة", "مسح_الذاكرة"],
        description="مسح سياق المحادثة والبدء من جديد مع جيميناي"
    )
    async def reset_chat(self, ctx: commands.Context):
        if ctx.author.id in self.user_chats:
            del self.user_chats[ctx.author.id]
            await ctx.send("🧹 تم مسح سياق محادثتك السابقة بنجاح!")
        else:
            await ctx.send("ℹ️ ليس لديك محادثة سابقة محفوظة لمسحها.")

    @commands.Cog.listener()
    async def on_message(self, message: discord.Message):
        if message.author.bot or not message.guild:
            return

        if self.bot.user in message.mentions:
            clean_content = message.content.replace(f"<@{self.bot.user.id}>", "").replace(f"<@!{self.bot.user.id}>", "").strip()
            if not clean_content:
                return await message.reply("أهلاً بك! كيف يمكنني مساعدتك اليوم؟ 🤖")

            async with message.channel.typing():
                reply_text = await self.generate_response(message.author.id, clean_content)
                if len(reply_text) <= 1900:
                    await message.reply(reply_text)
                else:
                    await self.send_split_message(message.channel, f"{message.author.mention}\n{reply_text}")

async def setup(bot):
    await bot.add_cog(GeminiAI(bot))
