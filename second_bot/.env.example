# Create a separate Discord application/bot token in the Discord Developer Portal.
# Use SECOND_BOT_TOKEN to avoid collision with Cosmo-Coins' shared panel variable.
SECOND_BOT_TOKEN=
# Backward-compatible fallback name, if needed:
# DISCORD_BOT_TOKEN=

# ID of the role allowed to use !say (the bot owner is also allowed).
SAY_ALLOWED_ROLE_ID=
