# Use the dedicated self-bot account token; the primary bot's token is not a fallback.
SECOND_BOT_TOKEN=

# ID of the role allowed to use $say (the account owner is also allowed).
SAY_ALLOWED_ROLE_ID=

# OpenAI key for the $numbers image-number extraction command.
OPENAI_API_KEY=
# Optional vision model override (default: gpt-4o-mini).
OPENAI_VISION_MODEL=gpt-4o-mini
