# Use the dedicated self-bot account token; the primary bot's token is not a fallback.
SECOND_BOT_TOKEN=

# ID of the role allowed to use $say (the account owner is also allowed).
SAY_ALLOWED_ROLE_ID=

# OCR.Space API key used only for type1 CAPTCHA images.
OCR_SPACE_API_KEY=
# Minimum gap between every OCR.Space request, shared by $numbers and $testall.
OCR_SPACE_MIN_INTERVAL_SECONDS=2
# Conservative local ceiling below OCR.Space's published free daily limit.
OCR_SPACE_DAILY_REQUEST_BUDGET=400
# Cooldown used after HTTP 429 when the response has no usable Retry-After header.
OCR_SPACE_429_COOLDOWN_SECONDS=3600

# Optional Veryfi fallback used only when OCR.Space variants disagree.
VERYFI_CLIENT_ID=
VERYFI_USERNAME=
VERYFI_API_KEY=
# Keep a safety margin below the free monthly allowance (default: 80).
VERYFI_MONTHLY_REQUEST_BUDGET=80

# Legacy vision-provider settings retained for compatibility with imported callers.
GEMINI_API_KEY=
# Optional vision model override (default: gemini-3.8-flash).
GEMINI_VISION_MODEL=gemini-3.8-flash
# Optional fallback used only after a timeout or temporary 429/5xx response.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional second provider. Create a free OpenRouter key to enable provider fallback.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openrouter/free
