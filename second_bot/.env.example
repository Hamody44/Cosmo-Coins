# Use the dedicated self-bot account token; the primary bot's token is not a fallback.
SECOND_BOT_TOKEN=

# Must exactly match COSMO_AUTO_DELIVERY_SECRET in the repository-root .env.
COSMO_AUTO_DELIVERY_SECRET=

# ID of the role allowed to use $say (the account owner is also allowed).
SAY_ALLOWED_ROLE_ID=

# Required for every type1 image-reading command ($numbers, $tc/self tc,
# and automatic confirmations). Type1 uses Gemini only.
GEMINI_API_KEY=
# Primary Gemini model and an optional second Gemini model for transient failures.
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Timeout for each type1 Gemini attempt.
TYPE1_AI_TIMEOUT_SECONDS=8
