# Use the dedicated self-bot account token; the primary bot's token is not a fallback.
SECOND_BOT_TOKEN=

# ID of the role allowed to use $say (the account owner is also allowed).
SAY_ALLOWED_ROLE_ID=

# Gemini API key for the $numbers image-number extraction command.
GEMINI_API_KEY=
# Optional vision model override (default: gemini-2.5-flash).
GEMINI_VISION_MODEL=gemini-2.5-flash
