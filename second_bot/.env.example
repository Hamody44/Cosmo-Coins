# Use the dedicated self-bot account token; the primary bot's token is not a fallback.
SECOND_BOT_TOKEN=

# ID of the role allowed to use $say (the account owner is also allowed).
SAY_ALLOWED_ROLE_ID=

# OCR.Space API key used only for type1 CAPTCHA images.
OCR_SPACE_API_KEY=

# Legacy vision-provider settings retained for compatibility with imported callers.
GEMINI_API_KEY=
# Optional vision model override (default: gemini-3.8-flash).
GEMINI_VISION_MODEL=gemini-3.8-flash
# Optional fallback used only after a timeout or temporary 429/5xx response.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional second provider. Create a free OpenRouter key to enable provider fallback.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openrouter/free
