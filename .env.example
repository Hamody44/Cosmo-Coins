# Discord bot and OAuth credentials (obtain from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# The public application ID is set in dashboard/app.py; this is the app's secret.
DISCORD_CLIENT_SECRET=

# Optional AI providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Developer name shown to the AI when users ask who developed the bot.
BOT_DEVELOPER_NAME=7amody77777

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Public dashboard URL used as the OAuth callback base
DASHBOARD_URL=

# LTCPay.com (BTCPay Greenfield) LTC top-ups. Configure the LTC wallet in your store.
# Create a store-scoped API key limited to invoice create/view, and configure the webhook
# at https://<DASHBOARD_HOST>/ltcpay/webhook for InvoiceProcessing/Settled/Expired/Invalid.
LTCPAY_URL=https://ltcpay.com
LTCPAY_STORE_ID=
LTCPAY_API_KEY=
LTCPAY_WEBHOOK_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable between deployments; never commit the generated value.
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=true
