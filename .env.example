# Discord bot and OAuth credentials (obtain from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# Shared HMAC key for signed exchange-delivery handoffs to second_bot.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the exact same value in second_bot/.env; never commit the generated key.
COSMO_AUTO_DELIVERY_SECRET=
# The public application ID is set in dashboard/app.py; this is the app's secret.
DISCORD_CLIENT_SECRET=

# Optional AI providers
GEMINI_API_KEY=
# Primary Gemini model (default: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional first fallback: Cerebras.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
# Developer name shown to the AI when users ask who developed the bot.
BOT_DEVELOPER_NAME=7amody77777

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Public dashboard URL used as the OAuth callback base
DASHBOARD_URL=

# LTCPay.com (BTCPay Greenfield) LTC top-ups. Configure the LTC wallet in your store.
# Create a store-scoped API key limited to invoice create/view, and configure the webhook
# at https://<DASHBOARD_HOST>/ltcpay/webhook for InvoiceProcessing/Settled/Expired/Invalid.
LTCPAY_URL=https://ltcpay.com
LTCPAY_STORE_ID=
LTCPAY_API_KEY=
LTCPAY_WEBHOOK_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable between deployments; never commit the generated value.
FLASK_SECRET_KEY=
# Separate signing key for short-lived Discord game identity tickets.
GAME_AUTH_SECRET=
SESSION_COOKIE_SECURE=true
# Brain Bot: create a separate Discord Application/Bot token in the Developer Portal.
# Never reuse DISCORD_BOT_TOKEN or SECOND_BOT_TOKEN here.
BRAIN_BOT_TOKEN=
# Discord user ID allowed to issue Brain Bot control commands (numeric, no quotes).
PRIMARY_OWNER_ID=
# Dedicated command prefix; keep distinct from primary (!) and second_bot ($).
BRAIN_BOT_PREFIX=#
