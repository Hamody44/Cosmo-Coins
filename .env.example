# Discord bot and OAuth credentials (obtain from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# The public application ID is set in dashboard/app.py; this is the app's secret.
DISCORD_CLIENT_SECRET=

# Optional AI providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Public dashboard URL used as the OAuth callback base
DASHBOARD_URL=

# BTCPay Server LTC top-ups. Configure an LTC wallet/node on the BTCPay store.
# API key should be limited to invoice creation/view for this store; create webhook at
# https://<DASHBOARD_HOST>/btcpay/webhook for InvoiceProcessing/Settled/Expired/Invalid.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable between deployments; never commit the generated value.
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=true
