# Discord bot and OAuth credentials (obtain from Discord Developer Portal)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional AI providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Public dashboard URL used as the OAuth callback base
DASHBOARD_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable between deployments; never commit the generated value.
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=true
