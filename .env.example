# Discord bot and OAuth credentials (obtain from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# The public application ID is set in dashboard/app.py; this is the app's secret.
DISCORD_CLIENT_SECRET=

# Optional AI providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# Public dashboard URL used as the OAuth callback base
DASHBOARD_URL=

# NOWPayments LTC top-ups (store API secrets only in the host's secret manager).
# The bot logs its current outbound IPv4/IPv6 on startup; whitelist the stable egress IP in NOWPayments.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public recipient wallet from the user; keep it on the Litecoin mainnet.
NOWPAYMENTS_PAYOUT_ADDRESS=ltc1qrn9vg3dcz7wuq6auf5xw4swzmuuzuu3wleu23m
NOWPAYMENTS_PAYOUT_CURRENCY=ltc
# false keeps the shown LTC quote exact; provider fees are deducted from merchant proceeds.
NOWPAYMENTS_FEE_PAID_BY_USER=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable between deployments; never commit the generated value.
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=true
