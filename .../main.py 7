@bot.hybrid_command(name="giveaway", aliases=["سحب", "جيف_اواي"], description="بدء سحب جيف أواي على عملات Cosmo بالريأكشن 🎉")
async def giveaway(ctx: commands.Context, amount: str, duration: str, winners_count: int, *, condition: str = None):
    if not is_bot_admin(ctx):
        return await ctx.send("⛔ ليس لديك صلاحية (أو انتهى اشتراك البريميوم بالسيرفر).")

    try:
        parsed_amount = parse_amount(amount)
    except:
        return await ctx.send("❌ صيغة المبلغ غير صحيحة.")

    if parsed_amount <= 0:
        return await ctx.send("❌ المبلغ يجب أن يكون أكبر من 0.")

    if winners_count <= 0:
        return await ctx.send("❌ يجب أن يكون عدد الفائزين 1 على الأقل.")

    total_cost = parsed_amount * winners_count
    allowed, pool_msg = deduct_server_spending(ctx.guild.id, total_cost)
    if not allowed:
        return await ctx.send(pool_msg)

    duration_seconds = parse_duration(duration)
    if not duration_seconds:
        refund_server_spending(ctx.guild.id, total_cost)
        return await ctx.send("❌ صيغة الوقت غير صحيحة. استخدم: `10s`، `5m`، `2h`، أو `1d`.")

    end_timestamp = int(time.time()) + duration_seconds

    embed = discord.Embed(
        title="🎉 سحب على عملات Cosmo! 🎉",
        description=f"**الجائزة لكل فائز:** `{parsed_amount:,}` Cosmo\n"
                    f"**عدد الفائزين:** `{winners_count}`\n"
                    f"**المشاركين:** `0`\n"
                    f"**الشرط:** {condition if condition else 'لا يوجد شرط'}\n"
                    f"**ينتهي:** <t:{end_timestamp}:R>",
        color=discord.Color.purple()
    )
    embed.set_footer(text="تفاعل بالريأكشن 🎉 للدخول في السحب!")

    msg = await ctx.send(embed=embed)
    await msg.add_reaction("🎉")

    g_conn, g_cur = get_guild_db(ctx.guild.id)
    g_cur.execute(
        "INSERT INTO active_giveaways (message_id, channel_id, amount, end_timestamp, winners_count, condition, participants_json, is_finished) VALUES (?, ?, ?, ?, ?, ?, '[]', 0)",
        (msg.id, ctx.channel.id, parsed_amount, end_timestamp, winners_count, condition)
    )
    g_conn.commit()
    g_conn.close()

    asyncio.create_task(monitor_giveaway(ctx.guild.id, ctx.channel.id, msg.id, parsed_amount, duration_seconds, winners_count, condition))

