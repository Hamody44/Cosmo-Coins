def get_guild_db(guild_id: int):
    db_path = f"guilds_data/guild_{guild_id}.db"
    conn = sqlite3.connect(db_path, check_same_thread=False)
    cur = conn.cursor()

    cur.execute('''CREATE TABLE IF NOT EXISTS settings (
        guild_id INTEGER PRIMARY KEY,
        transfer_log INTEGER,
        exchange_request_log INTEGER,
        exchange_success_log INTEGER,
        delivery_log INTEGER,
        balance_log INTEGER,
        admin_role_id INTEGER,
        blacklist_role_id INTEGER,
        exchange_enabled INTEGER DEFAULT 1,
        double_event_end INTEGER DEFAULT 0,
        spending_balance INTEGER DEFAULT 0
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS premium_info (
        guild_id INTEGER PRIMARY KEY,
        activated_at INTEGER DEFAULT 0,
        premium_end INTEGER DEFAULT 0,
        custom_name TEXT,
        custom_avatar_url TEXT
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS exchange_currencies (
        currency_name TEXT PRIMARY KEY,
        exchange_rate REAL,
        is_active INTEGER DEFAULT 1,
        min_received REAL DEFAULT 0
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS command_aliases (
        original_command TEXT,
        alias TEXT PRIMARY KEY
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS bot_whitelist (
        bot_id INTEGER,
        channel_id INTEGER,
        PRIMARY KEY (bot_id, channel_id)
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS active_giveaways (
        message_id INTEGER PRIMARY KEY,
        channel_id INTEGER,
        amount INTEGER,
        end_timestamp INTEGER,
        winners_count INTEGER,
        condition TEXT,
        participants_json TEXT,
        is_finished INTEGER DEFAULT 0
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS boost_system_config (
        guild_id INTEGER PRIMARY KEY,
        is_enabled INTEGER DEFAULT 0,
        single_boost_reward INTEGER DEFAULT 0,
        double_boost_reward INTEGER DEFAULT 0,
        boost_log_channel INTEGER DEFAULT 0
    )''')

    cur.execute('''CREATE TABLE IF NOT EXISTS active_boost_subscriptions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        boost_type INTEGER,
        weekly_reward INTEGER,
        payments_remaining INTEGER,
        next_payment_timestamp INTEGER,
        is_fake INTEGER DEFAULT 0
    )''')

    try:
        cur.execute("ALTER TABLE settings ADD COLUMN delivery_log INTEGER")
        conn.commit()
    except sqlite3.OperationalError:
        pass

    conn.commit()
    return conn, cur

# ----------------- ترحيل البيانات القديمة تلقائياً لسيرفر كوزمو -----------------
def migrate_existing_data():
    old_db = "cosmo_bot.db"
    if not os.path.exists(old_db):
        return

    try:
        old_conn = sqlite3.connect(old_db)
        old_cur = old_conn.cursor()

        try:
            old_cur.execute("SELECT user_id, balance FROM balances")
            for r in old_cur.fetchall():
                global_cursor.execute("INSERT OR REPLACE INTO balances (user_id, balance) VALUES (?, ?)", r)
            
            old_cur.execute("SELECT sender_id, receiver_id, amount, timestamp FROM transfer_logs")
            for r in old_cur.fetchall():
                global_cursor.execute("INSERT INTO transfer_logs (sender_id, receiver_id, amount, timestamp) VALUES (?, ?, ?, ?)", r)

            old_cur.execute("SELECT id, user_id, cosmo_amount, target_currency, received_amount, note, status, timestamp FROM exchange_logs")
            for r in old_cur.fetchall():
                global_cursor.execute("INSERT INTO exchange_logs (id, guild_id, user_id, cosmo_amount, target_currency, received_amount, note, status, timestamp) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
                                      (r[0], COSMO_GUILD_ID, r[1], r[2], r[3], r[4], r[5], r[6], r[7]))

            old_cur.execute("SELECT code, duration_seconds, created_at, is_used, used_guild_id FROM premium_codes")
            for r in old_cur.fetchall():
                global_cursor.execute("INSERT OR REPLACE INTO premium_codes (code, duration_seconds, created_at, is_used, used_guild_id) VALUES (?, ?, ?, ?, ?)", r)
            
            global_conn.commit()
        except Exception as e:
            print(f"Global migration note: {e}")

        g_conn, g_cur = get_guild_db(COSMO_GUILD_ID)
        try:
            old_cur.execute("SELECT * FROM settings LIMIT 1")
            s = old_cur.fetchone()
            if s:
                g_cur.execute("INSERT OR REPLACE INTO settings (guild_id, transfer_log, exchange_request_log, exchange_success_log, balance_log, admin_role_id, blacklist_role_id, exchange_enabled, double_event_end, spending_balance) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                              (COSMO_GUILD_ID, s[1], s[2], s[3], s[4], s[5], s[6], s[7] if len(s)>7 else 1, s[8] if len(s)>8 else 0, s[10] if len(s)>10 else 0))
                if len(s) > 9 and s[9]:
                    g_cur.execute("INSERT OR REPLACE INTO premium_info (guild_id, activated_at, premium_end) VALUES (?, ?, ?)",
                                  (COSMO_GUILD_ID, int(time.time()), s[9]))

            old_cur.execute("SELECT currency_name, exchange_rate, is_active, min_received FROM exchange_currencies")
            for r in old_cur.fetchall():
                g_cur.execute("INSERT OR REPLACE INTO exchange_currencies (currency_name, exchange_rate, is_active, min_received) VALUES (?, ?, ?, ?)", r)

            old_cur.execute("SELECT bot_id, channel_id FROM bot_whitelist")
            for r in old_cur.fetchall():
                g_cur.execute("INSERT OR REPLACE INTO bot_whitelist (bot_id, channel_id) VALUES (?, ?)", r)

            g_conn.commit()
        except Exception as e:
            print(f"Cosmo Guild migration note: {e}")
        finally:
            g_conn.close()

        old_conn.close()
        shutil.move(old_db, f"cosmo_bot_old_migrated_{int(time.time())}.db")
    except Exception as e:
        print(f"Migration error: {e}")

migrate_existing_data()

