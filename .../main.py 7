@bot.hybrid_command(name="server_count", aliases=["عدد_السيرفرات"], description="عرض قائمة السيرفرات المتواجد بها البوت وروابطها (مالك البوت)")
async def server_count(ctx: commands.Context):
    if not await check_is_owner(ctx):
        total_guilds = len(bot.guilds)
        total_members = sum(g.member_count for g in bot.guilds if g.member_count)
        return await ctx.send(f"📊 يتواجد البوت حالياً في **{total_guilds}** سيرفر، ويخدم أكثر من **{total_members:,}** عضو.")

    await ctx.defer()

    total_guilds = len(bot.guilds)
    total_members = sum(g.member_count for g in bot.guilds if g.member_count)

    server_entries = []

    for idx, guild in enumerate(bot.guilds, 1):
        invite_link = None
        try:
            invites = await guild.invites()
            if invites:
                invite_link = invites[0].url
        except:
            pass

        if not invite_link:
            for channel in guild.text_channels:
                if channel.permissions_for(guild.me).create_instant_invite:
                    try:
                        new_inv = await channel.create_invite(max_age=0, max_uses=0, reason="Server List Owner Inspection")
                        invite_link = new_inv.url
                        break
                    except:
                        continue

        invite_display = f"[اضغط هنا للدخول]({invite_link})" if invite_link else "`لا تتوفر صلاحية إنشاء رابط`"
        
        entry = (
            f"**#{idx} | {guild.name}**\n"
            f"• **ID:** `{guild.id}`\n"
            f"• **الأعضاء:** `{guild.member_count:,}`\n"
            f"• **رابط الدعوة:** {invite_display}\n"
        )
        server_entries.append(entry)

    chunks = []
    current_chunk = ""
    for entry in server_entries:
        if len(current_chunk) + len(entry) > 1800:
            chunks.append(current_chunk)
            current_chunk = entry
        else:
            current_chunk += entry
    if current_chunk:
        chunks.append(current_chunk)

    for i, chunk in enumerate(chunks, 1):
        embed = discord.Embed(
            title=f"📊 قائمة سيرفرات البوت ({total_guilds} سيرفر) - صفحة {i}/{len(chunks)}",
            description=f"👥 **إجمالي الأعضاء:** `{total_members:,}` عضو\n\n" + chunk,
            color=discord.Color.blue()
        )
        embed.set_footer(text=f"طلب بواسطة المالك: {ctx.author.name}")
        await ctx.send(embed=embed)

