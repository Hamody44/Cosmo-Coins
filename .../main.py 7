# ----------------- مهمة تسليم دفعات البوست الأسبوعية (مع احتساب الوقت الضائع) -----------------
@tasks.loop(minutes=15)
async def process_boost_weekly_payments():
    now = int(time.time())
    for guild in bot.guilds:
        g_conn, g_cur = get_guild_db(guild.id)
        g_cur.execute("SELECT id, user_id, boost_type, weekly_reward, payments_remaining, next_payment_timestamp, is_fake FROM active_boost_subscriptions WHERE next_payment_timestamp <= ?", (now,))
        due_payments = g_cur.fetchall()

        for sub in due_payments:
            sub_id, u_id, b_type, reward, remaining, next_pay_ts, is_fake = sub
            member = guild.get_member(u_id)

            if not is_fake and (not member or not member.premium_since):
                g_cur.execute("DELETE FROM active_boost_subscriptions WHERE id = ?", (sub_id,))
                g_conn.commit()
                continue

            weeks_passed = ((now - next_pay_ts) // (7 * 86400)) + 1
            payments_to_give = min(weeks_passed, remaining)

            total_due_reward = payments_to_give * reward
            update_balance(u_id, total_due_reward)

            new_remaining = remaining - payments_to_give

            if new_remaining <= 0:
                g_cur.execute("DELETE FROM active_boost_subscriptions WHERE id = ?", (sub_id,))
            else:
                updated_next_pay = next_pay_ts + (payments_to_give * 7 * 86400)
                if updated_next_pay <= now:
                    updated_next_pay = now + (7 * 86400)
                g_cur.execute("UPDATE active_boost_subscriptions SET payments_remaining = ?, next_payment_timestamp = ? WHERE id = ?", (new_remaining, updated_next_pay, sub_id))
            g_conn.commit()

            type_str = "دبل بوست 🚀🚀" if b_type == 2 else "بوست 🚀"
            missed_text = f" (شملت {payments_to_give} دفعة مستحقة)" if payments_to_give > 1 else ""

            if member:
                try:
                    await member.send(
                        f"💎 **دفعة بوست جديدة:** تم تسليم `{total_due_reward:,}` Cosmo لدعمك السيرفر بـ {type_str}{missed_text}!\n"
                        f"(الدفعات المتبقية: `{new_remaining}`)."
                    )
                except:
                    pass

            g_cur.execute("SELECT boost_log_channel FROM boost_system_config WHERE guild_id = ?", (guild.id,))
            log_row = g_cur.fetchone()
            if log_row and log_row[0]:
                log_chan = guild.get_channel(log_row[0])
                if log_chan:
                    await log_chan.send(
                        f"💎 تم تسليم دفعة البوست للعضو <@{u_id}> بقيمة `{total_due_reward:,}` Cosmo لدعمه بـ {type_str}{missed_text} (المتبقي: `{new_remaining}`)."
                    )

        g_conn.close()

# ----------------- استئناف سحوبات الجيف أواي النشطة بعد إعادة التشغيل -----------------
async def finish_giveaway(guild: discord.Guild, channel: discord.TextChannel, msg_id: int, amount: int, winners_count: int, condition: str, participants: list):
    g_conn, g_cur = get_guild_db(guild.id)
    g_cur.execute("UPDATE active_giveaways SET is_finished = 1 WHERE message_id = ?", (msg_id,))
    g_conn.commit()
    g_conn.close()

    valid_participants = [uid for uid in participants if guild.get_member(uid) and not is_blacklisted(guild.get_member(uid))]
    if not valid_participants:
        refund_server_spending(guild.id, amount * winners_count)
        return await channel.send(f"⚠️ انتهى السحب على `{amount:,}` Cosmo، ولكن لم يشترك أحد (أُعيدت الميزانية للسيرفر).")

    winners_ids = random.sample(valid_participants, min(len(valid_participants), winners_count))
    winners = [guild.get_member(uid) for uid in winners_ids]
    winners_mentions = ", ".join([w.mention for w in winners])

    if len(winners) < winners_count:
        refund_amount = (winners_count - len(winners)) * amount
        refund_server_spending(guild.id, refund_amount)

    if not condition:
        for winner in winners:
            update_balance(winner.id, amount)
            try:
                await winner.send(f"🎉 مبروك! فزت بـ `{amount:,}` Cosmo في السحب وتم تسليمها تلقائياً.")
            except:
                pass
        await channel.send(f"🎊 مبارك للفائزين: {winners_mentions}!\nتم تسليم `{amount:,}` Cosmo تلقائياً لكل فائز.")
    else:
        await channel.send(f"🎊 الفائزون بالقرعة: {winners_mentions}!\n⚠️ **الشرط:** `{condition}`\nفي انتظار مراجعة الإدارة للتسليم.")
        for winner in winners:
            claim_view = ClaimVerificationView(winner, amount, "جائزة الجيف أواي")
            await channel.send(f"تحقق من شرط العضو {winner.mention}:", view=claim_view)

async def monitor_giveaway(guild_id: int, channel_id: int, msg_id: int, amount: int, duration_sec: int, winners_count: int, condition: str):
    await asyncio.sleep(duration_sec)
    guild = bot.get_guild(guild_id)
    if not guild:
        return
    channel = guild.get_channel(channel_id)
    if not channel:
        return

    g_conn, g_cur = get_guild_db(guild_id)
    g_cur.execute("SELECT participants_json, is_finished FROM active_giveaways WHERE message_id = ?", (msg_id,))
    row = g_cur.fetchone()
    g_conn.close()

    if row and row[1] == 0:
        participants = json.loads(row[0]) if row[0] else []
        await finish_giveaway(guild, channel, msg_id, amount, winners_count, condition, participants)

async def resume_all_giveaways():
    await bot.wait_until_ready()
    now = int(time.time())
    for guild in bot.guilds:
        g_conn, g_cur = get_guild_db(guild.id)
        g_cur.execute("SELECT message_id, channel_id, amount, end_timestamp, winners_count, condition, participants_json FROM active_giveaways WHERE is_finished = 0")
        rows = g_cur.fetchall()
        g_conn.close()

        for r in rows:
            msg_id, chan_id, amount, end_time, winners_cnt, condition, part_json = r
            channel = guild.get_channel(chan_id)
            if not channel:
                continue
            participants = json.loads(part_json) if part_json else []

            if now >= end_time:
                asyncio.create_task(finish_giveaway(guild, channel, msg_id, amount, winners_cnt, condition, participants))
            else:
                remaining = end_time - now
                asyncio.create_task(monitor_giveaway(guild.id, chan_id, msg_id, amount, remaining, winners_cnt, condition))

# ----------------- دالة معالجة دخول البوست للنظام -----------------
async def register_member_boost(guild: discord.Guild, member: discord.Member, boost_count: int, is_fake: bool = False):
    g_conn, g_cur = get_guild_db(guild.id)
    g_cur.execute("SELECT is_enabled, single_boost_reward, double_boost_reward, boost_log_channel FROM boost_system_config WHERE guild_id = ?", (guild.id,))
    cfg = g_cur.fetchone()

    if not cfg or cfg[0] == 0:
        g_conn.close()
        return False, "نظام البوست غير مفعّل حالياً في هذا السيرفر."

    is_enabled, single_reward, double_reward, log_chan_id = cfg
    reward_per_week = double_reward if boost_count >= 2 else single_reward

    if reward_per_week <= 0:
        g_conn.close()
        return False, "لم يتم تحديد مكافآت لنظام البوست بعد."

    update_balance(member.id, reward_per_week)
    now = int(time.time())
    next_payment = now + (7 * 86400)

    g_cur.execute(
        "INSERT INTO active_boost_subscriptions (user_id, boost_type, weekly_reward, payments_remaining, next_payment_timestamp, is_fake) VALUES (?, ?, ?, 3, ?, ?)",
        (member.id, boost_count, reward_per_week, next_payment, 1 if is_fake else 0)
    )
    g_conn.commit()
    g_conn.close()

    type_str = "دبل بوست 🚀🚀" if boost_count >= 2 else "بوست 🚀"
    
    try:
        await member.send(
            f"🎉 **شكراً لدعمك سيرفر {guild.name}!**\n"
            f"تم تفعيل اشتراكك في نظام مكافآت الـ {type_str}:\n"
            f"• استلمت الدفعة الأولى فوراً: `{reward_per_week:,}` Cosmo!\n"
            f"• متبقي لك: `3` دفعات أسبوعية (كل 7 أيام دفعة طالما البوست مستمر).\n"
            f"• موعد الدفعة القادمة: <t:{next_payment}:F> (<t:{next_payment}:R>)."
        )
    except:
        pass

    if log_chan_id:
        chan = guild.get_channel(log_chan_id)
        if chan:
            await chan.send(
                f"🚀 قام {member.mention} بعمل **{type_str}** للسيرفر!\n"
                f"تم تسليم الدفعة الأولى تلقائياً (`{reward_per_week:,}` Cosmo) مع جدولة 3 دفعات أسبوعية قادمة."
            )

    return True, f"تم تسجيل اشتراك {type_str} وتسليم الدفعة الأولى بنجاح!"

