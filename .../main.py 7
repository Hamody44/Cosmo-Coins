@bot.hybrid_command(name="add_alias", aliases=["اضافة_اختصار"], description="إضافة اختصار جديد لأي أمر خاص بهذا السيرفر")
async def add_alias(ctx: commands.Context, original_command: str, new_alias: str):
    if not is_bot_admin(ctx):
        return await ctx.send("⛔ ليس لديك صلاحية (أو انتهى اشتراك البريميوم بالسيرفر).")
    cmd = bot.get_command(original_command)
    if not cmd:
        return await ctx.send("❌ الأمر الأساسي غير موجود.")
    
    g_conn, g_cur = get_guild_db(ctx.guild.id)
    g_cur.execute("INSERT OR REPLACE INTO command_aliases (original_command, alias) VALUES (?, ?)", (original_command, new_alias.strip()))
    g_conn.commit()
    g_conn.close()
    await ctx.send(f"✅ تم تعيين الاختصار `{new_alias}` للأمر `{original_command}` في هذا السيرفر بنجاح.")

TOKEN = os.getenv("DISCORD_BOT_TOKEN")

if not TOKEN:
    raise ValueError("❌ لم يتم العثور على التوكن في ملف .env!")

bot.run(TOKEN)

