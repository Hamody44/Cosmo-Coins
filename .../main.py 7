async def check_is_owner(ctx_or_user):
    user = ctx_or_user.author if hasattr(ctx_or_user, "author") else ctx_or_user
    if user.id == PRIMARY_OWNER_ID:
        return True
    try:
        return await bot.is_owner(user)
    except:
        return False

def is_guild_premium(guild_id: int) -> bool:
    g_conn, g_cur = get_guild_db(guild_id)
    g_cur.execute("SELECT premium_end FROM premium_info WHERE guild_id = ?", (guild_id,))
    row = g_cur.fetchone()
    g_conn.close()
    if row and row[0]:
        return int(time.time()) < row[0]
    return False

def is_bot_admin(ctx):
    if ctx.author.id == PRIMARY_OWNER_ID:
        return True

    if not is_guild_premium(ctx.guild.id):
        return False

    if ctx.author.id == ctx.guild.owner_id:
        return True

    g_conn, g_cur = get_guild_db(ctx.guild.id)
    g_cur.execute("SELECT 1 FROM bot_whitelist WHERE bot_id = ? AND channel_id = ?", (ctx.author.id, ctx.channel.id))
    if g_cur.fetchone():
        g_conn.close()
        return True

    g_cur.execute("SELECT admin_role_id FROM settings WHERE guild_id = ?", (ctx.guild.id,))
    row = g_cur.fetchone()
    g_conn.close()
    if row and row[0]:
        role = ctx.guild.get_role(row[0])
        if role and role in ctx.author.roles:
            return True
    return False

def get_server_spending_balance(guild_id: int) -> int:
    g_conn, g_cur = get_guild_db(guild_id)
    g_cur.execute("SELECT spending_balance FROM settings WHERE guild_id = ?", (guild_id,))
    row = g_cur.fetchone()
    g_conn.close()
    return row[0] if row and row[0] else 0

def deduct_server_spending(guild_id: int, amount: int) -> tuple[bool, str]:
    g_conn, g_cur = get_guild_db(guild_id)
    g_cur.execute("SELECT spending_balance FROM settings WHERE guild_id = ?", (guild_id,))
    row = g_cur.fetchone()
    current_pool = row[0] if row and row[0] else 0

    if current_pool < amount:
        g_conn.close()
        return False, f"⛔ ميزانية السيرفر المتاحة للصرف غير كافية! المطلوب: `{amount:,}` Cosmo، والمتبقي: `{current_pool:,}` Cosmo."

    new_pool = current_pool - amount
    g_cur.execute("UPDATE settings SET spending_balance = ? WHERE guild_id = ?", (new_pool, guild_id))
    g_conn.commit()
    g_conn.close()
    return True, f"🪙 المتبقي من ميزانية السيرفر: `{new_pool:,}` Cosmo."

def refund_server_spending(guild_id: int, amount: int):
    g_conn, g_cur = get_guild_db(guild_id)
    g_cur.execute("UPDATE settings SET spending_balance = spending_balance + ? WHERE guild_id = ?", (amount, guild_id))
    g_conn.commit()
    g_conn.close()

def is_blacklisted(member: discord.Member) -> bool:
    if not member or not hasattr(member, "guild") or not member.guild:
        return False
    g_conn, g_cur = get_guild_db(member.guild.id)
    g_cur.execute("SELECT blacklist_role_id FROM settings WHERE guild_id = ?", (member.guild.id,))
    row = g_cur.fetchone()
    g_conn.close()
    if row and row[0]:
        role = member.guild.get_role(row[0])
        if role and role in member.roles:
            return True
    return False

def get_balance(user_id):
    global_cursor.execute("SELECT balance FROM balances WHERE user_id = ?", (user_id,))
    row = global_cursor.fetchone()
    return row[0] if row else 0

def update_balance(user_id, amount):
    bal = get_balance(user_id) + amount
    global_cursor.execute("INSERT OR REPLACE INTO balances (user_id, balance) VALUES (?, ?)", (user_id, bal))
    global_conn.commit()

def parse_amount(amount_str: str) -> int:
    amount_str = str(amount_str).strip().lower()
    multipliers = {'k': 1_000, 'm': 1_000_000, 'b': 1_000_000_000}
    if amount_str[-1] in multipliers:
        unit = amount_str[-1]
        number = float(amount_str[:-1])
        return int(number * multipliers[unit])
    return int(float(amount_str))

def parse_duration(time_str: str) -> int:
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    match = re.match(r"^(\d+)([smhd])$", time_str.lower())
    if not match:
        return None
    val, unit = match.groups()
    return int(val) * units[unit]

def clean_display_name(name: str) -> str:
    cleaned = "".join([c for c in name if c.isprintable()]).strip()
    return cleaned[:10] if cleaned else "Player"

def get_unicode_font(size: int):
    font_paths = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        "DejaVuSans.ttf",
        "arial.ttf"
    ]
    for p in font_paths:
        try:
            return ImageFont.truetype(p, size)
        except:
            continue
    return ImageFont.load_default()

def generate_captcha_image(text):
    base_img = Image.new('RGB', (120, 40), color=(25, 25, 30))
    draw = ImageDraw.Draw(base_img)
    spaced_text = " ".join(text)
    draw.text((20, 12), spaced_text, fill=(255, 255, 255))
    big_img = base_img.resize((300, 100), resample=Image.NEAREST)
    draw_big = ImageDraw.Draw(big_img)
    for _ in range(5):
        draw_big.line([random.randint(0, 300), random.randint(0, 100), random.randint(0, 300), random.randint(0, 100)], fill=(90, 90, 110), width=2)
    buf = io.BytesIO()
    big_img.save(buf, format='PNG')
    buf.seek(0)
    return buf

async def generate_roulette_wheel_image(guild: discord.Guild, participants: list, selected_index: int):
    size = 600
    image = Image.new('RGBA', (size, size), (0, 0, 0, 0))
    draw = ImageDraw.Draw(image)
    center = size // 2
    radius = 260

    num_parts = len(participants)
    angle_per_part = 360 / num_parts
    palette = [(107, 142, 100), (155, 110, 155), (150, 150, 140), (145, 115, 85), (90, 130, 140), (170, 130, 100)]
    font = get_unicode_font(18)

    for i in range(num_parts):
        start_angle = i * angle_per_part
        end_angle = (i + 1) * angle_per_part
        color = palette[i % len(palette)]
        draw.pieslice([center - radius, center - radius, center + radius, center + radius], start=start_angle, end=end_angle, fill=color, outline=(255, 255, 255), width=2)
        
        mid_angle = math.radians((start_angle + end_angle) / 2)
        text_dist = radius * 0.65
        tx = center + text_dist * math.cos(mid_angle)
        ty = center + text_dist * math.sin(mid_angle)
        name_str = clean_display_name(participants[i].display_name)
        draw.text((tx - 24, ty - 10), name_str, fill=(255, 255, 255), font=font)

    inner_radius = 80
    if guild.icon:
        try:
            icon_bytes = await guild.icon.read()
            icon_img = Image.open(io.BytesIO(icon_bytes)).convert("RGBA")
            icon_img = icon_img.resize((inner_radius * 2, inner_radius * 2))
            mask = Image.new('L', (inner_radius * 2, inner_radius * 2), 0)
            mask_draw = ImageDraw.Draw(mask)
            mask_draw.ellipse((0, 0, inner_radius * 2, inner_radius * 2), fill=255)
            output_icon = ImageOps.fit(icon_img, mask.size, centering=(0.5, 0.5))
            output_icon.putalpha(mask)
            image.paste(output_icon, (center - inner_radius, center - inner_radius), output_icon)
        except:
            draw.ellipse([center - inner_radius, center - inner_radius, center + inner_radius, center + inner_radius], fill=(35, 30, 50), outline=(255, 255, 255), width=4)
    else:
        draw.ellipse([center - inner_radius, center - inner_radius, center + inner_radius, center + inner_radius], fill=(35, 30, 50), outline=(255, 255, 255), width=4)

    target_angle = math.radians((selected_index * angle_per_part) + (angle_per_part / 2))
    ptr_x = center + (radius + 20) * math.cos(target_angle)
    ptr_y = center + (radius + 20) * math.sin(target_angle)
    draw.polygon([(ptr_x, ptr_y), (ptr_x + 25 * math.cos(target_angle + 0.4), ptr_y + 25 * math.sin(target_angle + 0.4)), (ptr_x + 25 * math.cos(target_angle - 0.4), ptr_y + 25 * math.sin(target_angle - 0.4))], fill=(255, 255, 255), outline=(0, 0, 0))

    buf = io.BytesIO()
    image.save(buf, format='PNG')
    buf.seek(0)
    return buf

